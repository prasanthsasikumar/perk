# ---- Core ----
# Postgres connection string (Supabase: use the "Transaction" pooler URL, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perk
# Public origin of this deployment, no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Owner auth (Auth.js magic links) ----
# openssl rand -base64 32
AUTH_SECRET=change-me
# Resend API key. Leave empty in dev to log magic links to the console instead of emailing.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Perk <login@perk.app>"

# ---- Logo storage (Supabase Storage, public bucket) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOGO_BUCKET=logos

# ---- Staff PIN cookie signing ----
# openssl rand -base64 32
STAFF_COOKIE_SECRET=change-me

# ---- Apple Wallet (base64-encoded PEM files) ----
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.app.perk.card
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_PEM=
# APNs auth key (.p8) for pushing pass updates
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PEM=

# ---- Google Wallet ----
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY_PEM=

# ---- Dev/test ----
# 1 = skip real pass signing and wallet HTTP calls (web card still works)
WALLET_DRY_RUN=1
